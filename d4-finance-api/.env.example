# Copy this file to `.env` (already gitignored) and fill in real values.
# Never commit `.env` — these are this service's own secrets, not shared
# with any other app in the workspace.

PORT=8001

# Used by POST /api/reports/{id}/send. Swap the stub in main.py for a real
# smtplib/SES/SendGrid call once these are real.
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=reports@yourcompany.com
SMTP_PASSWORD=replace-with-real-secret
