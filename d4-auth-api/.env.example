# Copy this file to `.env` (already gitignored) and fill in real values.
# Never commit `.env`.

PORT=8003

# Signs and verifies session tokens. MUST be a long random secret, and MUST
# be a DIFFERENT value in every environment (dev/QA/UAT/prod) — a leaked QA
# secret must never be able to forge a valid prod session.
AUTH_SECRET_KEY=replace-with-a-long-random-string-per-environment

TOKEN_TTL_MINUTES=480
