# Copy this file to `.env` (already gitignored) and fill in real values.
# Never commit `.env` — these are this service's own secrets, not shared
# with any other app in the workspace.

PORT=8002

# Used by POST /api/jd/generate. Swap the stub in main.py for a real
# LLM call (OpenAI/Anthropic/etc.) once this is real — the key never leaves
# this server; the frontend only ever sees the generated text.
AI_API_KEY=replace-with-real-secret
